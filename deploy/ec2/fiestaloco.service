[Unit]
Description=FiestaLoco realtime game server
Documentation=https://github.com/acokgunlu/fiestaloco
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fiesta
Group=fiesta
WorkingDirectory=/opt/fiestaloco/app
EnvironmentFile=/etc/fiestaloco.env
ExecStart=/usr/bin/node /opt/fiestaloco/app/dist-server/server.cjs

# Cokerse her zaman geri gel. Parti ortasinda elle mudahale gerekmesin.
Restart=always
RestartSec=2
# Restart firtinasina karsi: 5 dakikada 10 denemeden fazlasi olursa dur.
StartLimitIntervalSec=300
StartLimitBurst=10

# Kapanirken sunucu tum odalarin snapshot'ini Supabase'e yaziyor ve
# istemcilere server:restarting gonderiyor — bunun bitmesi icin sure taniyoruz.
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fiestaloco

# --- Guvenlik sinirlamalari ---------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fiestaloco
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
