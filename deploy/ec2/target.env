# FiestaLoco — EC2 hedef bilgileri (gizli deger YOK, git'e girebilir)
#
# Sunucudaki gercek sirlar (Supabase service_role, Gemini) /etc/fiestaloco.env
# icinde durur ve oraya asla git'ten gitmez — bkz. scripts/set-secrets-ec2.sh

# Elastic IP — instance yeniden baslasa bile degismez.
FIESTA_HOST=63.186.47.36

# Oyun sunucusunun public adresi. Caddy bu isim icin sertifika alir.
# Vercel DNS'inde: A kaydi  api  ->  63.186.47.36
FIESTA_DOMAIN=api.fiestaloco.site

FIESTA_SSH_USER=ubuntu
FIESTA_SSH_KEY=~/.ssh/fiestaloco-key.pem

# AWS
FIESTA_INSTANCE_ID=i-0642c3d0bb8fbf71e
FIESTA_REGION=eu-central-1
