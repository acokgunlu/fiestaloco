# =============================================================================
# FiestaLoco — ortam degiskenleri
# =============================================================================
# Yerel gelistirme icin bu dosyayi `.env.local` olarak kopyalayin.
# Uretimde:
#   VITE_* degiskenleri  -> Vercel (frontend)
#   digerleri            -> AWS EC2 (oyun sunucusu, /etc/fiestaloco.env)
# =============================================================================


# -----------------------------------------------------------------------------
# FRONTEND (Vercel)
# -----------------------------------------------------------------------------

# Oyun sunucusunun public adresi. WebSocket ve /api cagrilari buraya gider.
# Bos birakilirsa same-origin kullanilir (yerel `npm run dev` icin dogru davranis).
# Ornek: https://api.fiestaloco.site
VITE_SERVER_URL=""


# -----------------------------------------------------------------------------
# OYUN SUNUCUSU (AWS EC2 — bkz. .env.server.example + scripts/set-secrets-ec2.sh)
# -----------------------------------------------------------------------------

# Platform otomatik atar; yerelde bos birakabilirsiniz (varsayilan 3000).
PORT=3000

# Uretimde "production" olmali. Aksi halde sunucu Vite dev middleware'ini yukler.
NODE_ENV=development

# Virgulle ayrilmis izinli frontend origin listesi. Hem CORS hem WebSocket
# upgrade kontrolu bunu kullanir. Bos = tum origin'lere izin (kolay ilk kurulum).
# localhost her zaman serbesttir. Joker destegi vardir: https://*.vercel.app
# Ornek: https://fiestaloco.vercel.app,https://*.vercel.app
ALLOWED_ORIGINS=""

# "false" yapilirsa dist/ klasoru mevcut olsa bile statik frontend servis edilmez.
# Vercel + EC2 split kurulumunda dist/ zaten sunucuya gitmez; uretimde "false".
SERVE_STATIC="true"


# -----------------------------------------------------------------------------
# SUPABASE (leaderboard, mac gecmisi, oda snapshot'lari)
# -----------------------------------------------------------------------------
# Bos birakilirsa sunucu salt bellek-ici calisir: oyunlar sorunsuz oynanir ama
# skorlar kalici olmaz ve restart aktif odalari dusurur.
#
# service_role anahtarini Supabase panelinden alin:
#   Project Settings -> API -> Project API keys -> service_role (secret)
# BU ANAHTAR GIZLIDIR. Asla frontend'e veya git'e koymayin — yalnizca sunucuda.

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Oda snapshot yazma araligi (ms). 0 = periyodik snapshot kapali.
SNAPSHOT_INTERVAL_MS=15000

# Bu dakikadan eski snapshot'lar sunucu acilisinda geri yuklenmez.
SNAPSHOT_MAX_AGE_MINUTES=180


# -----------------------------------------------------------------------------
# GEMINI (opsiyonel)
# -----------------------------------------------------------------------------
# Yalnizca 3 opsiyonel ozellik icin kullanilir:
#   - Imposter kelime cifti uretimi
#   - Codenames AI ipucu (yapay zeka spymaster)
#   - Trivia Pursuit dinamik soru uretimi
# Tanimli degilse hepsi yerel soru/kelime bankasina duser, oyun calismaya devam eder.
GEMINI_API_KEY=""
