# =============================================================================
# FiestaLoco — SUNUCU sirlari (EC2)
# =============================================================================
#   cp .env.server.example .env.server
#   # degerleri doldurun, sonra:
#   ./scripts/set-secrets-ec2.sh
#
# .env.server .gitignore kapsaminda — git'e girmez.
# Bu dosyadaki hicbir deger frontend bundle'ina gitmez (VITE_ onekli degiller).
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Bos birakilirsa sunucu salt bellek-ici calisir: oyunlar sorunsuz oynanir ama
# skor tablosu kalici olmaz ve restart aktif odalari dusurur.
SUPABASE_URL=https://lqpbfvzkfgxwatboente.supabase.co

# GIZLI. Supabase paneli -> Project Settings -> API -> Project API keys
#        -> service_role (secret)
# Bu anahtar tum RLS'i bypass eder. Asla frontend'e veya git'e koymayin.
SUPABASE_SERVICE_ROLE_KEY=

# --- Origin kisitlamasi -------------------------------------------------------
# Virgulle ayrilmis izinli frontend origin listesi (CORS + WebSocket upgrade).
# Bos = herkese acik. localhost her zaman serbest. Joker destegi var.
ALLOWED_ORIGINS=https://fiestaloco.site,https://www.fiestaloco.site,https://*.vercel.app

# --- Gemini (opsiyonel) -------------------------------------------------------
# Imposter kelime cifti, Codenames AI ipucu, Trivia dinamik soru uretimi.
# Bos ise hepsi yerel soru/kelime bankasina duser, oyun calismaya devam eder.
GEMINI_API_KEY=

# --- Snapshot ayarlari (varsayilanlar iyi) ------------------------------------
SNAPSHOT_INTERVAL_MS=15000
SNAPSHOT_MAX_AGE_MINUTES=180
